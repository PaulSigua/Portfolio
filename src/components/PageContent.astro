---
import Experience from "./Experience.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Services from "./Services.astro";
import SectionContainer from "./SectionContainer.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;

const titles = {
  en: "Paúl Sigua | Frontend & Full Stack Developer",
  es: "Paúl Sigua | Desarrollador Frontend & Full Stack",
};

const descriptions = {
  en: "Frontend & Full Stack developer specialized in TypeScript, JavaScript, PHP, Angular, React, and WordPress. Building fast, scalable, and responsive web applications.",
  es: "Desarrollador Frontend & Full Stack especializado en TypeScript, JavaScript, PHP, Angular, React y WordPress. Construcción de aplicaciones web interactivas, rápidas y escalables.",
};
---

<Layout title={titles[lang]} description={descriptions[lang]} lang={lang}>
  <main class="bg-app text-app relative">
    <Header lang={lang} />

    <SectionContainer class="xl:pt-0">
      <section
        id="hero"
        class="pt-24 pb-12 relative mx-auto w-full min-h-[100dvh] flex items-center justify-center"
      >
        <Hero lang={lang} />
      </section>

      <section
        id="experience"
        class="pt-24 pb-12 relative mx-auto w-full min-h-[100dvh] flex items-center justify-center"
      >
        <Experience lang={lang} />
      </section>

      <section
        id="services"
        class="pt-24 pb-12 relative mx-auto w-full min-h-[100dvh] flex items-center justify-center"
      >
        <Services lang={lang} />
      </section>

      <section
        id="projects"
        class="pt-24 pb-16 relative mx-auto w-full min-h-[100dvh] flex items-center justify-center"
      >
        <Projects lang={lang} />
      </section>
    </SectionContainer>
  </main>
</Layout>
