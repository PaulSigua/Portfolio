---
import Badge from "./icons/Badge.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const PROJECTS = [
  {
    id: "thearomatrace",
    titleKey: "projects.thearomatrace.title",
    badgeKey: "projects.thearomatrace.badge",
    descriptionKey: "projects.thearomatrace.description",
    url: "https://thearomatrace.com/",
    tags: [
      { text: "WordPress", color: "purple" },
      { text: "WooCommerce", color: "purple" },
      { text: "PHP", color: "black" },
      { text: "CSS", color: "blue" },
    ],
    gradientStyle:
      "background: radial-gradient(circle at 10% 10%, rgba(224, 242, 254, 0.95) 0%, rgba(255, 255, 255, 1) 65%);",
  },
  {
    id: "ordania",
    titleKey: "projects.ordania.title",
    badgeKey: "projects.ordania.badge",
    descriptionKey: "projects.ordania.description",
    url: "https://ordania.com/",
    tags: [
      { text: "Angular", color: "red" },
      { text: "Tailwind CSS", color: "purple" },
      { text: "TypeScript", color: "blue" },
    ],
    gradientStyle:
      "background: radial-gradient(circle at 10% 10%, rgba(209, 250, 229, 0.9) 0%, rgba(255, 255, 255, 1) 65%);",
  },
  {
    id: "kea",
    titleKey: "projects.kea.title",
    badgeKey: "projects.kea.badge",
    descriptionKey: "projects.kea.description",
    url: "https://github.com/PaulSigua",
    tags: [
      { text: "Angular", color: "red" },
      { text: "CSS", color: "purple" },
    ],
    gradientStyle:
      "background: radial-gradient(circle at 10% 10%, rgba(243, 232, 255, 0.9) 0%, rgba(255, 255, 255, 1) 65%);",
  },
];
---

<section id="projects-section" class="w-full mx-auto">
  <div class="portfolio-card p-6 sm:p-8 md:p-10">
    <!-- Header de la Sección -->
    <div class="text-center space-y-3 mb-10 sm:mb-12">
      <div class="section-tag">
        <span>04</span>
        <span>•</span>
        <span>{lang === "es" ? "PROYECTOS" : "PROJECTS"}</span>
      </div>
      <h2 class="section-title">
        {t("projects.title")}
      </h2>
      <p class="section-subtitle">
        {t("projects.subtitle")}
      </p>
    </div>

    <!-- Cuadrícula Limpia y Espaciosa de 3 Tarjetas Blancas -->
    <div
      id="projects-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch"
    >
      {
        PROJECTS.map((project) => (
          <article
            class="project-grid-card group rounded-[2rem] p-6 sm:p-7 flex flex-col justify-between min-h-[380px] bg-white text-zinc-950 border border-zinc-200/90 shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 relative overflow-hidden"
            style={project.gradientStyle}
          >
            <!-- Capa Hover Liquid Glass Gradient hasta la mitad (con bordes redondeados exactos) -->
            <div
              class="liquid-glass-half absolute inset-x-0 bottom-0 h-1/2 rounded-b-[2rem] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-10 overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--primary)]/20 via-[var(--primary)]/10 to-transparent"></div>
            </div>

            <!-- ── Cabecera: Título, Badge y Descripción ──────────────────────── -->
            <div class="relative z-20">
              <div class="flex items-center justify-between gap-2 mb-3">
                <h3 class="font-black text-2xl text-zinc-950 tracking-tight leading-tight transition-colors">
                  {t(project.titleKey as any)}
                </h3>
                <span class="bg-black text-white text-[10px] sm:text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-xs shrink-0 whitespace-nowrap">
                  {t(project.badgeKey as any)}
                </span>
              </div>

              <!-- Descripción Real del Proyecto -->
              <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed mb-6 font-normal">
                {t(project.descriptionKey as any)}
              </p>
            </div>

            <!-- ── Pie: Badges de Tecnologías y Botón de Acción ───────────────── -->
            <div class="relative z-20 pt-4 border-t border-zinc-100 flex flex-col gap-4">
              <!-- Badges de Tecnologías Correctas -->
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <Badge color={tag.color}>{tag.text}</Badge>
                ))}
              </div>

              <!-- Botón de Acción Estandarizado -->
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary w-full py-3.5 text-xs sm:text-sm font-bold shadow-md hover:shadow-lg"
                aria-label={`Ver proyecto ${t(project.titleKey as any)}`}
              >
                <span>{t("projects.visit")}</span>
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-grid-card {
    border-radius: 2rem;
    overflow: hidden;
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .liquid-glass-half {
    border-bottom-left-radius: 2rem;
    border-bottom-right-radius: 2rem;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    overflow: hidden;
  }
</style>

<script>
  import { gsap } from "gsap";

  const section = document.getElementById("projects-section");
  const cards = document.querySelectorAll<HTMLElement>(".project-grid-card");

  if (section) {
    gsap.set(cards, { y: 24, opacity: 0 });

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          gsap.to(cards, {
            y: 0,
            opacity: 1,
            duration: 0.6,
            stagger: 0.12,
            ease: "power3.out",
          });
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );

    observer.observe(section);
  }
</script>
