---
import Badge from "./icons/Badge.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const EXPERIENCE = [
  {
    dateKey: "experience.job1.date",
    titleKey: "experience.job1.title",
    companyKey: "experience.job1.company",
    url: "https://mycodedmind.com/",
    logo: "https://mycodedmind.com/images/logotipo.png",
    descriptionKey: "experience.job1.description",
    tags: [
      { text: "React", color: "blue" },
      { text: "WordPress", color: "purple" },
      { text: "Angular", color: "red" },
      { text: "Vue.js", color: "green" },
      { text: "JavaScript", color: "yellow" },
      { text: "PHP", color: "black" },
    ],
    current: true,
  },
  {
    dateKey: "experience.job2.date",
    titleKey: "experience.job2.title",
    companyKey: "experience.job2.company",
    url: "https://starflowers.com.ec",
    logo: "https://starflowers.com.ec/_astro/icon-logo.Bi0O_rGO_Z1iLfJp.svg",
    descriptionKey: "experience.job2.description",
    tags: [
      { text: "Python", color: "green" },
      { text: "Angular", color: "red" },
      { text: "SQL Server", color: "yellow" },
      { text: "FastAPI", color: "purple" },
    ],
    current: false,
  },
  {
    dateKey: "experience.job3.date",
    titleKey: "experience.job3.title",
    companyKey: "experience.job3.company",
    url: "https://www.ups.edu.ec",
    logo: "https://upload.wikimedia.org/wikipedia/commons/b/b0/Logo_Universidad_Polit%C3%A9cnica_Salesiana_del_Ecuador.png",
    descriptionKey: "experience.job3.description",
    tags: [
      { text: "Flutter", color: "sky" },
      { text: "Java", color: "slate" },
      { text: "Python", color: "green" },
      { text: "C++", color: "blue" },
    ],
    current: false,
  },
];
---

<section id="exp-section" class="w-full max-w-4xl mx-auto">
  <div class="portfolio-card p-6 sm:p-10 md:p-14">
    <!-- Header de la Sección -->
    <div class="text-center space-y-3 mb-10">
      <div class="section-tag">
        <span>02</span>
        <span>•</span>
        <span>{lang === "es" ? "EXPERIENCIA" : "EXPERIENCE"}</span>
      </div>
      <h2 class="section-title">
        {t("experience.title")}
      </h2>
      <p class="section-subtitle">
        {t("experience.subtitle")}
      </p>
    </div>

    <!-- Stack de Tarjetas Interactivas Expandibles (Acordeón) -->
    <div class="flex flex-col gap-4 max-w-3xl mx-auto" id="exp-accordion">
      {
        EXPERIENCE.map((exp, index) => {
          const numStr = String(index + 1).padStart(2, "0");
          const isOpen = index === 0; // Primer item abierto por defecto
          return (
            <div
              class={`exp-card group overflow-hidden ${isOpen ? "is-open" : ""}`}
              data-index={index}
            >
              <!-- Cabecera Clicable de la Tarjeta -->
              <button
                type="button"
                class="exp-trigger w-full flex items-center justify-between p-4 sm:p-5 text-left cursor-pointer select-none gap-3 focus:outline-none"
                aria-expanded={isOpen ? "true" : "false"}
              >
                <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                  <!-- Número Index Circular (Leve, sutil en dark mode) -->
                  <span class="exp-num">
                    {numStr}
                  </span>

                  <!-- Logo de la Empresa -->
                  <div class="exp-logo-box shadow-2xs">
                    <img
                      src={exp.logo}
                      alt={t(exp.companyKey as any)}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>

                  <!-- Título del Puesto y Empresa -->
                  <div class="flex flex-col min-w-0">
                    <h3 class="font-bold text-sm sm:text-base md:text-lg text-app truncate">
                      {t(exp.titleKey as any)}
                    </h3>
                    <span class="text-xs sm:text-sm text-muted truncate">
                      {t(exp.companyKey as any)}
                    </span>
                  </div>
                </div>

                <!-- Fecha y Botón de Toggle (+) -->
                <div class="flex items-center gap-3 shrink-0">
                  <span
                    class={`text-[11px] sm:text-xs font-semibold px-3 py-1 rounded-full border whitespace-nowrap hidden sm:inline-flex ${
                      exp.current
                        ? "bg-[var(--primary)]/10 text-[var(--primary)] border-[var(--primary)]/20"
                        : "bg-badge text-muted border-app-soft"
                    }`}
                  >
                    {t(exp.dateKey as any)}
                  </span>

                  <!-- Botón de Acción Circular -->
                  <div class="exp-toggle-btn shadow-2xs">
                    <svg
                      class={`size-4 transition-transform duration-300 ${isOpen ? "rotate-45" : "rotate-0"}`}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </div>
                </div>
              </button>

              <!-- Contenido Expandible -->
              <div
                class="exp-content transition-[max-height,opacity] duration-300 ease-in-out overflow-hidden"
                style={
                  isOpen
                    ? "max-height: 500px; opacity: 1;"
                    : "max-height: 0px; opacity: 0;"
                }
              >
                <div class="px-5 sm:px-6 pb-6 pt-2 border-t border-app-soft/30 space-y-4">
                  <!-- Badge de Fecha en Mobile -->
                  <div class="sm:hidden">
                    <span
                      class={`text-[11px] font-semibold px-2.5 py-0.5 rounded-full border inline-flex ${
                        exp.current
                          ? "bg-[var(--primary)]/10 text-[var(--primary)] border-[var(--primary)]/20"
                          : "bg-badge text-muted border-app-soft"
                      }`}
                    >
                      {t(exp.dateKey as any)}
                    </span>
                  </div>

                  <!-- Descripción Detallada -->
                  <p class="text-sm sm:text-[15px] leading-relaxed text-muted">
                    {t(exp.descriptionKey as any)}
                  </p>

                  <!-- Tecnologías y Enlace a la Empresa -->
                  <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                    <div class="flex flex-wrap gap-1.5">
                      {exp.tags.map((tag) => (
                        <Badge color={tag.color}>{tag.text}</Badge>
                      ))}
                    </div>

                    <a
                      href={exp.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-xs font-bold text-[var(--primary)] hover:underline ml-auto"
                    >
                      <span>{t("experience.visitCompany")}</span>
                      <svg
                        class="size-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 17L17 7"></path>
                        <path d="M7 7h10v10"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Pie de Sección -->
    <div
      class="mt-10 pt-6 border-t border-app-soft/40 text-center flex flex-col sm:flex-row items-center justify-center gap-2"
    >
      <p class="text-xs sm:text-sm text-muted">
        {t("experience.footer.text")}
      </p>
      <button
        onclick="window.toggleDialog('modal-service-contact')"
        class="text-xs sm:text-sm font-bold text-[var(--primary)] hover:underline inline-flex items-center gap-1 cursor-pointer"
      >
        <span>{t("experience.footer.cta")}</span>
        <span>→</span>
      </button>
    </div>
  </div>
</section>

<style>
  .exp-card {
    border-radius: 1.5rem;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :root[data-theme="dark"] .exp-card,
  .dark .exp-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .exp-card:hover {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.12);
  }

  :root[data-theme="dark"] .exp-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
  }

  /* Estado Abierto: Sutil y elegante en ambos temas */
  .exp-card.is-open {
    background: rgba(255, 255, 255, 0.5);
    border-color: var(--primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05), 0 0 0 1px var(--primary) inset;
  }

  :root[data-theme="dark"] .exp-card.is-open,
  .dark .exp-card.is-open {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--primary);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--primary) inset;
  }

  /* Numeradores circulares 01, 02, 03: Leves, sin blanco chillón */
  .exp-num {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-main);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  :root[data-theme="dark"] .exp-num,
  .dark .exp-num {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e4e4e7;
  }

  .exp-card:hover .exp-num,
  .exp-card.is-open .exp-num {
    color: var(--primary);
    border-color: var(--primary);
    background: rgba(var(--primary-rgb, 99, 102, 241), 0.1);
  }

  /* Contenedor de Logo */
  .exp-logo-box {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: #ffffff;
    padding: 0.35rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  :root[data-theme="dark"] .exp-logo-box,
  .dark .exp-logo-box {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Botón Circular de Toggle (+ / x) */
  .exp-toggle-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  :root[data-theme="dark"] .exp-toggle-btn,
  .dark .exp-toggle-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f4f4f5;
  }

  .exp-card.is-open .exp-toggle-btn {
    background: var(--primary);
    color: var(--primary-fg);
    border-color: var(--primary);
  }
</style>

<script>
  import { gsap } from "gsap";

  // Lógica interactiva del acordeón
  const cards = document.querySelectorAll<HTMLElement>(".exp-card");

  cards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>(".exp-trigger");
    const content = card.querySelector<HTMLElement>(".exp-content");
    const icon = card.querySelector<SVGElement>(".exp-toggle-btn svg");

    if (!trigger || !content) return;

    trigger.addEventListener("click", () => {
      const isOpen = card.classList.contains("is-open");

      if (isOpen) {
        // Cerrar tarjeta
        card.classList.remove("is-open");
        content.style.maxHeight = "0px";
        content.style.opacity = "0";
        trigger.setAttribute("aria-expanded", "false");
        if (icon) {
          icon.classList.remove("rotate-45");
          icon.classList.add("rotate-0");
        }
      } else {
        // Abrir esta tarjeta
        card.classList.add("is-open");
        content.style.maxHeight = `${content.scrollHeight + 40}px`;
        content.style.opacity = "1";
        trigger.setAttribute("aria-expanded", "true");
        if (icon) {
          icon.classList.remove("rotate-0");
          icon.classList.add("rotate-45");
        }
      }
    });
  });

  // Animación de entrada GSAP al scroll
  const section = document.getElementById("exp-section");
  if (section) {
    gsap.set(cards, { y: 24, opacity: 0 });

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          gsap.to(cards, {
            y: 0,
            opacity: 1,
            duration: 0.6,
            stagger: 0.12,
            ease: "power3.out",
          });
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );

    observer.observe(section);
  }
</script>
