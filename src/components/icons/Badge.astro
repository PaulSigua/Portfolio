---
const { color = "gray" } = Astro.props as {
  color?:
    | "green"
    | "red"
    | "yellow"
    | "orange"
    | "purple"
    | "gray"
    | "blue"
    | "slate"
    | "sky"
    | "black";
};

const colorClasses: Record<string, string> = {
  green:
    "bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20",
  red: "bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/20",
  yellow:
    "bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/20",
  orange:
    "bg-orange-500/10 text-orange-800 dark:text-orange-300 border-orange-500/20",
  purple:
    "bg-purple-500/10 text-purple-800 dark:text-purple-300 border-purple-500/20",
  gray: "bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 border-zinc-500/20",
  blue: "bg-blue-500/10 text-blue-800 dark:text-blue-300 border-blue-500/20",
  slate:
    "bg-slate-500/10 text-slate-800 dark:text-slate-300 border-slate-500/20",
  sky: "bg-sky-500/10 text-sky-800 dark:text-sky-300 border-sky-500/20",
  black:
    "bg-black/5 dark:bg-white/10 text-zinc-800 dark:text-zinc-200 border-black/10 dark:border-white/15",
};

const badgeClass = colorClasses[color] || colorClasses.gray;
---

<span
  class={`text-[11px] font-semibold font-mono px-2.5 py-0.5 rounded-full border shadow-2xs inline-flex items-center gap-1 ${badgeClass}`}
>
  <slot />
</span>

