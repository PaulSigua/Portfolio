---
interface Props {
  id: string;
  title?: string;
}

const { id, title } = Astro.props;
---

<dialog
  id={id}
  class="custom-modal flex-col gap-4 bg-app text-app border border-white/60 rounded-2xl p-6"
>
  <div class="flex justify-between items-center w-full">
    {
      title && (
        <h3 id={`${id}-title`} class="text-xl font-semibold">
          {title}
        </h3>
      )
    }
    <button
      class="close-btn text-muted hover:text-red-500 cursor-pointer p-2 bg-black/5 rounded-full ml-auto"
      onclick="window.toggleDialog()"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="18" y1="6" x2="6" y2="18"></line><line
          x1="6"
          y1="6"
          x2="18"
          y2="18"></line></svg
      >
    </button>
  </div>
  <div class="modal-content">
    <slot />
  </div>
</dialog>

<script>
  import gsap from "gsap";
  import { Flip } from "gsap/Flip";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(Flip, CustomEase);

  declare global {
    interface Window {
      toggleDialog: (dialogId?: string) => false;
    }
  }

  if (typeof window.toggleDialog !== "function") {
    const MARGIN = 12;
    const EASE_OPEN = CustomEase.create(
      "pm-open",
      "M0,0 C0.305,0.206 0.116,0.567 0.3,0.8 0.394,0.921 0.491,1 1,1",
    );

    function measureDialog(dialog: HTMLDialogElement) {
      dialog.style.visibility = "hidden";
      dialog.show();
      const w = dialog.offsetWidth || 320;
      const h = dialog.offsetHeight || 200;
      dialog.close();
      dialog.style.visibility = "";
      return { w, h };
    }

    function positionDialog(
      dialog: HTMLDialogElement,
      trigger: Element | null,
    ) {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const { w: dw, h: dh } = measureDialog(dialog);

      let left: number;
      let top: number;

      if (trigger) {
        const tr = trigger.getBoundingClientRect();
        left = tr.left + tr.width / 2 - dw / 2;
        top = tr.top + tr.height / 2 - dh / 2;
        left = Math.max(MARGIN, Math.min(vw - dw - MARGIN, left));
        top = Math.max(MARGIN, Math.min(vh - dh - MARGIN, top));
      } else {
        left = Math.max(MARGIN, (vw - dw) / 2);
        top = Math.max(MARGIN, (vh - dh) / 2);
      }

      dialog.style.top = `${top}px`;
      dialog.style.left = `${left}px`;
    }

    let lastOpenedAt = 0;

    window.toggleDialog = function (dialogId?: string): false {
      // ── CLOSE ────────────────────────────────────────────────────────
      if (!dialogId) {
        const open = document.querySelector<HTMLDialogElement>("dialog[open]");
        if (!open) return false;

        gsap.killTweensOf(open);

        const originId = open.dataset.flipId;
        const origin = originId
          ? document.querySelector<Element>(
              `[data-flip-id="${originId}"]:not([open])`,
            )
          : null;

        if (origin) {
          const originState = Flip.getState(origin);
          Flip.to(originState, {
            targets: open,
            scale: true,
            ease: "power2.in",
            duration: 0.5,
            toggleClass: "pm-closing",
            onComplete: () => {
              gsap.set(open, { clearProps: "all" });
              open.style.top = "";
              open.style.left = "";
              open.close();
              open.removeAttribute("data-flip-id");
              if (origin instanceof HTMLElement) delete origin.dataset.flipId;
              document.body.style.overflow = "";
            },
          });
        } else {
          gsap.to(open, {
            opacity: 0,
            scale: 0.9,
            duration: 0.25,
            ease: "power2.in",
            onComplete: () => {
              gsap.set(open, { clearProps: "all" });
              open.style.top = "";
              open.style.left = "";
              open.close();
              document.body.style.overflow = "";
            },
          });
        }
        return false;
      }

      // ── OPEN ─────────────────────────────────────────────────────────
      const dialog = document.getElementById(
        dialogId,
      ) as HTMLDialogElement | null;
      if (!dialog) return false;

      const already = document.querySelector<HTMLDialogElement>("dialog[open]");
      if (already && already !== dialog) {
        gsap.killTweensOf(already);
        gsap.set(already, { clearProps: "all" });
        already.style.top = "";
        already.style.left = "";
        already.close();
        already.removeAttribute("data-flip-id");
      }

      const trigger: Element | null =
        window.event instanceof Event &&
        window.event.currentTarget instanceof Element
          ? window.event.currentTarget
          : null;

      positionDialog(dialog, trigger ?? document.activeElement);

      document.body.style.overflow = "hidden";

      if (trigger instanceof HTMLElement) {
        const randomId = Math.random().toString(16).slice(2);
        dialog.dataset.flipId = randomId;
        trigger.dataset.flipId = randomId;

        gsap.killTweensOf(dialog);
        const originState = Flip.getState(trigger);
        dialog.showModal();
        Flip.from(originState, {
          targets: dialog,
          scale: true,
          ease: EASE_OPEN,
          duration: 0.7,
          toggleClass: "pm-opening",
        });
      } else {
        dialog.showModal();
        gsap.from(dialog, {
          opacity: 0,
          scale: 0.9,
          duration: 0.4,
          ease: "power2.out",
        });
      }

      lastOpenedAt = Date.now();
      return false;
    };

    document.addEventListener("click", (e) => {
      if (Date.now() - lastOpenedAt < 100) return;
      const dialog = document.querySelector<HTMLDialogElement>("dialog[open]");
      if (!dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) window.toggleDialog();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = document.querySelector<HTMLDialogElement>("dialog[open]");
      if (open) {
        e.preventDefault();
        window.toggleDialog();
      }
    });
  }
</script>
