---
import SunIcon from "./icons/Sun.astro";
import MoonIcon from "./icons/Moon.astro";
import SystemIcon from "./icons/System.astro";
import LanguageIcon from "./icons/Language.astro";
import { languages } from "../i18n/ui";
import { useTranslations, getRouteFromLang } from "../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const THEMES = ["Light", "Dark", "System"];
const languageEntries = Object.entries(languages);
---

<header
  id="header-container"
  class="fixed w-full z-50 top-0 pt-6 px-4 transition-all duration-500 ease-in-out flex justify-center"
>
  <!-- Contenedor Píldora Liquid Glass -->
  <nav
    id="nav-pill"
    class="relative w-full max-w-[1200px] h-16 liquid-glass rounded-full px-4 sm:px-6 flex justify-between items-center gap-2 md:gap-4 z-20"
  >
    <!-- Logo / Brand (Izquierda) -->
    <div class="flex-shrink-0 flex items-center">
      <a href="#hero" class="flex items-center gap-2.5 group focus:outline-none">
        <span
          class="size-9 rounded-full bg-[var(--primary)]/15 border border-[var(--primary)]/30 flex items-center justify-center text-[var(--primary)] group-hover:scale-105 transition-transform duration-300 shadow-xs"
        >
          <svg
            class="size-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </span>
        <span
          class="font-bold text-base md:text-lg text-app tracking-tight group-hover:text-[var(--primary)] transition-colors duration-200 whitespace-nowrap"
        >
          Paúl Sigua
        </span>
      </a>
    </div>

    <!-- Links Escritorio (Centro en flujo Flex) -->
    <div
      class="hidden md:flex items-center justify-center gap-1 lg:gap-2 flex-1 min-w-0"
    >
      <a
        href="#hero"
        class="nav-item relative text-app/80 hover:text-app dark:hover:text-white px-3 lg:px-4 py-2 text-sm font-semibold transition-colors duration-200 whitespace-nowrap"
      >
        <span class="relative z-10">{t("nav.home")}</span>
        <div class="menu-blur-spot"></div>
      </a>
      <a
        href="#experience"
        class="nav-item relative text-app/80 hover:text-app dark:hover:text-white px-3 lg:px-4 py-2 text-sm font-semibold transition-colors duration-200 whitespace-nowrap"
      >
        <span class="relative z-10">{t("nav.experience")}</span>
        <div class="menu-blur-spot"></div>
      </a>
      <a
        href="#services"
        class="nav-item relative text-app/80 hover:text-app dark:hover:text-white px-3 lg:px-4 py-2 text-sm font-semibold transition-colors duration-200 whitespace-nowrap"
      >
        <span class="relative z-10">{t("nav.services")}</span>
        <div class="menu-blur-spot"></div>
      </a>
      <a
        href="#projects"
        class="nav-item relative text-app/80 hover:text-app dark:hover:text-white px-3 lg:px-4 py-2 text-sm font-semibold transition-colors duration-200 whitespace-nowrap"
      >
        <span class="relative z-10">{t("nav.projects")}</span>
        <div class="menu-blur-spot"></div>
      </a>
    </div>

    <!-- Controles, CTA & Mobile Toggle (Derecha) -->
    <div class="flex-shrink-0 flex items-center gap-1 sm:gap-2">
      <!-- Selector de Idioma -->
      <div class="relative flex items-center justify-center">
        <button
          id="language-toggle-btn"
          class="cursor-pointer size-9 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 text-app transition-transform duration-200 hover:scale-105 focus:outline-none"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="language-menu"
          title={t("language.select")}
        >
          <LanguageIcon class="size-4.5 transition-all text-app" />
        </button>

        <div
          id="language-menu"
          class="absolute hidden top-full mt-3 right-0 text-sm p-1.5 min-w-[8.5rem] rounded-2xl liquid-glass shadow-xl z-50 dropdown-menu-animate"
          role="menu"
          aria-label="Seleccionar idioma"
        >
          <ul class="flex flex-col gap-1 outline-none" id="language-list">
            {
              languageEntries.map(([code, name]) => (
                <li>
                  <a
                    href={getRouteFromLang(code as "en" | "es")}
                    class="w-full px-3 py-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 flex items-center gap-2.5 justify-between text-app cursor-pointer transition-colors text-xs font-medium"
                    role="menuitemradio"
                    aria-checked={lang === code ? "true" : "false"}
                    data-language={code}
                  >
                    <span class="flex items-center gap-2">
                      <span>{code === "en" ? "🇺🇸" : "🇪🇸"}</span>
                      <span>{name}</span>
                    </span>
                    {lang === code && (
                      <span class="size-1.5 rounded-full bg-[var(--primary)]" />
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Selector de Tema (Centrado perfecto de iconos) -->
      <div class="relative flex items-center justify-center">
        <button
          id="theme-toggle-btn"
          class="cursor-pointer size-9 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 text-app transition-transform duration-200 hover:scale-105 focus:outline-none relative"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="themes-menu"
          title={t("theme.select")}
        >
          <div class="relative size-5 flex items-center justify-center">
            <SunIcon
              id="light"
              class="theme-toggle-icon absolute inset-0 m-auto size-4.5 transition-all duration-300 origin-center"
            />
            <MoonIcon
              id="dark"
              class="theme-toggle-icon absolute inset-0 m-auto size-4.5 transition-all duration-300 origin-center"
            />
            <SystemIcon
              id="system"
              class="theme-toggle-icon absolute inset-0 m-auto size-4.5 transition-all duration-300 origin-center"
            />
          </div>
        </button>

        <div
          id="themes-menu"
          class="absolute hidden top-full mt-3 right-0 text-sm p-1.5 min-w-[7.5rem] rounded-2xl liquid-glass shadow-xl z-50 dropdown-menu-animate"
          role="menu"
          aria-label="Seleccionar tema"
        >
          <ul class="flex flex-col gap-1 outline-none" id="themes-list">
            {
              THEMES.map((theme) => (
                <li>
                  <button
                    type="button"
                    class="themes-menu-option w-full px-3 py-1.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 flex items-center gap-2 justify-between text-app cursor-pointer transition-colors text-xs font-medium"
                    role="menuitemradio"
                    aria-checked="false"
                    data-theme={theme.toLowerCase()}
                  >
                    <span>{t(`theme.${theme.toLowerCase()}` as any)}</span>
                    <span class="check-dot hidden size-1.5 rounded-full bg-[var(--primary)]" />
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Selector de Paleta de Color -->
      <div class="relative flex items-center justify-center">
        <button
          id="color-palette-btn"
          onclick="window.toggleDialog('color-selector')"
          class="cursor-pointer size-9 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 text-app transition-transform duration-200 hover:scale-105 focus:outline-none"
          title={t("header.color-selector")}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5 text-app"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
            <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
            <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
            <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
            <path
              d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
            ></path>
          </svg>
        </button>
      </div>

      <!-- Botón CTA Contacto (Escritorio) -->
      <a
        href="#services"
        class="hidden md:inline-flex items-center justify-center h-10 px-6 rounded-full font-bold text-sm bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-[var(--primary-fg)] shadow-xs hover:shadow-md hover:scale-105 active:scale-95 transition-all duration-200 ml-1 cursor-pointer"
      >
        <span>{t("nav.contact")}</span>
      </a>

      <!-- Botón Menú Móvil -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-app size-9 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors focus:outline-none cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg
          id="mobile-menu-icon-open"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          id="mobile-menu-icon-close"
          class="size-5 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Menú Móvil Desplegable -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-4 right-4 mt-2.5 p-5 rounded-3xl liquid-glass liquid-glass-scrolled shadow-2xl flex-col gap-4 dropdown-menu-animate z-50"
  >
    <div class="flex flex-col gap-1.5">
      <a
        href="#hero"
        class="mobile-nav-link text-app font-semibold text-base py-2.5 px-4 rounded-2xl hover:bg-black/5 dark:hover:bg-white/10 transition-colors flex items-center justify-between"
      >
        <span>{t("nav.home")}</span>
        <span class="text-xs text-muted font-mono">01</span>
      </a>
      <a
        href="#experience"
        class="mobile-nav-link text-app font-semibold text-base py-2.5 px-4 rounded-2xl hover:bg-black/5 dark:hover:bg-white/10 transition-colors flex items-center justify-between"
      >
        <span>{t("nav.experience")}</span>
        <span class="text-xs text-muted font-mono">02</span>
      </a>
      <a
        href="#services"
        class="mobile-nav-link text-app font-semibold text-base py-2.5 px-4 rounded-2xl hover:bg-black/5 dark:hover:bg-white/10 transition-colors flex items-center justify-between"
      >
        <span>{t("nav.services")}</span>
        <span class="text-xs text-muted font-mono">03</span>
      </a>
      <a
        href="#projects"
        class="mobile-nav-link text-app font-semibold text-base py-2.5 px-4 rounded-2xl hover:bg-black/5 dark:hover:bg-white/10 transition-colors flex items-center justify-between"
      >
        <span>{t("nav.projects")}</span>
        <span class="text-xs text-muted font-mono">04</span>
      </a>
    </div>

    <div class="h-px bg-app-soft/40 my-1"></div>

    <div class="flex items-center justify-between pt-1">
      <span class="text-xs text-muted font-medium">Paúl Sigua</span>
      <a
        href="#services"
        class="mobile-nav-link inline-flex items-center justify-center h-10 px-5 rounded-full font-bold text-sm bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-[var(--primary-fg)] shadow-md"
      >
        <span>{t("nav.contact")}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .theme-toggle-icon {
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
  }
  .theme-toggle-icon.active {
    transform: scale(1);
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  // ── Scroll Interaction ───────────────────────────────────────────
  const headerContainer = document.getElementById("header-container");
  const navPill = document.getElementById("nav-pill");

  let isScrolled = false;

  function updateScrollState() {
    const shouldBeScrolled = window.scrollY > 20;
    if (shouldBeScrolled !== isScrolled) {
      isScrolled = shouldBeScrolled;
      if (isScrolled) {
        headerContainer?.classList.remove("pt-6");
        headerContainer?.classList.add("pt-2");
        navPill?.setAttribute("nav-compacted", "");
        navPill?.classList.remove("max-w-[1200px]");
        navPill?.classList.add("max-w-[880px]", "liquid-glass-scrolled");
      } else {
        headerContainer?.classList.remove("pt-2");
        headerContainer?.classList.add("pt-6");
        navPill?.removeAttribute("nav-compacted");
        navPill?.classList.remove("max-w-[880px]", "liquid-glass-scrolled");
        navPill?.classList.add("max-w-[1200px]");
      }
    }
  }

  window.addEventListener("scroll", updateScrollState, { passive: true });
  updateScrollState();

  // ── Mobile Menu Toggle ───────────────────────────────────────────
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("mobile-menu-icon-open");
  const iconClose = document.getElementById("mobile-menu-icon-close");

  function toggleMobileMenu(open?: boolean) {
    if (!mobileMenu) return;
    const isHidden = mobileMenu.classList.contains("hidden");
    const show = open !== undefined ? open : isHidden;

    if (show) {
      mobileMenu.classList.remove("hidden");
      mobileMenu.classList.add("flex");
      mobileMenuButton?.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
      mobileMenuButton?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  }

  mobileMenuButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleMobileMenu();
  });

  // Cerrar menú móvil al hacer clic en un enlace interno
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => toggleMobileMenu(false));
  });

  // ── Language Menu Toggle ─────────────────────────────────────────
  const languageToggleBtn = document.getElementById("language-toggle-btn");
  const languageMenu = document.getElementById("language-menu");

  if (languageToggleBtn && languageMenu) {
    languageToggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !languageMenu.classList.contains("hidden");
      if (isOpen) {
        languageMenu.classList.add("hidden");
        languageToggleBtn.setAttribute("aria-expanded", "false");
      } else {
        // Cerrar tema si está abierto
        document.getElementById("themes-menu")?.classList.add("hidden");
        document.getElementById("theme-toggle-btn")?.setAttribute("aria-expanded", "false");

        languageMenu.classList.remove("hidden");
        languageToggleBtn.setAttribute("aria-expanded", "true");
      }
    });

    const languageLinks = languageMenu.querySelectorAll("a[data-language]");
    languageLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        sessionStorage.setItem("scrollPosition", window.scrollY.toString());
        sessionStorage.setItem("currentHash", window.location.hash);
        window.location.href = link.getAttribute("href") || "/";
      });
    });
  }

  // ── Theme Menu Toggle ────────────────────────────────────────────
  const themeBtn = document.getElementById("theme-toggle-btn");
  const themeMenu = document.getElementById("themes-menu");

  if (themeBtn && themeMenu) {
    themeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !themeMenu.classList.contains("hidden");
      if (isOpen) {
        themeMenu.classList.add("hidden");
        themeBtn.setAttribute("aria-expanded", "false");
      } else {
        // Cerrar idioma si está abierto
        languageMenu?.classList.add("hidden");
        languageToggleBtn?.setAttribute("aria-expanded", "false");

        themeMenu.classList.remove("hidden");
        themeBtn.setAttribute("aria-expanded", "true");
      }
    });
  }

  // ── Global Clicks & Escape Key ───────────────────────────────────
  document.addEventListener("click", (e) => {
    const target = e.target as Node;

    if (
      languageMenu &&
      !languageMenu.contains(target) &&
      !languageToggleBtn?.contains(target)
    ) {
      languageMenu.classList.add("hidden");
      languageToggleBtn?.setAttribute("aria-expanded", "false");
    }

    if (
      themeMenu &&
      !themeMenu.contains(target) &&
      !themeBtn?.contains(target)
    ) {
      themeMenu.classList.add("hidden");
      themeBtn?.setAttribute("aria-expanded", "false");
    }

    if (
      mobileMenu &&
      !mobileMenu.contains(target) &&
      !mobileMenuButton?.contains(target)
    ) {
      toggleMobileMenu(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      languageMenu?.classList.add("hidden");
      languageToggleBtn?.setAttribute("aria-expanded", "false");
      themeMenu?.classList.add("hidden");
      themeBtn?.setAttribute("aria-expanded", "false");
      toggleMobileMenu(false);
    }
  });

  // ── Restore Scroll on Language Switch ────────────────────────────
  window.addEventListener("load", () => {
    const savedScrollPosition = sessionStorage.getItem("scrollPosition");
    const savedHash = sessionStorage.getItem("currentHash");

    if (savedScrollPosition) {
      sessionStorage.removeItem("scrollPosition");
      sessionStorage.removeItem("currentHash");

      setTimeout(() => {
        window.scrollTo({
          top: parseInt(savedScrollPosition),
          behavior: "smooth",
        });

        if (savedHash) {
          history.replaceState(null, "", savedHash);
        }
      }, 100);
    }
  });
</script>
