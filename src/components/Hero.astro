---
import Linkedin from "./icons/Linkedin.astro";
import Github from "./icons/Github.astro";
import Mail from "./icons/Mail.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const SOCIALS = [
  {
    href: "https://www.linkedin.com/in/paulsigua/",
    icon: Linkedin,
    label: "LinkedIn",
  },
  {
    href: "https://github.com/PaulSigua",
    icon: Github,
    label: "GitHub",
  },
  {
    href: "mailto:paulmateo0208@gmail.com",
    icon: Mail,
    label: "Email",
  },
];
---

<div
  class="flex flex-col-reverse lg:grid lg:grid-cols-10 gap-8 w-full justify-center items-center py-12"
>
  <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
    <div id="hero-badge" class="flex justify-center lg:justify-start">
      <span
        class="inline-flex items-center gap-2 py-1.5 px-3 rounded-full text-xs font-medium
                   bg-badge border border-[var(--primary)] text-[var(--primary)] shadow-sm hover:shadow-md transition-shadow"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--primary)] opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2 w-2 bg-[var(--primary)]"
          ></span>
        </span>
        {t("hero.available")}
      </span>
    </div>

    <h1
      class="hero-title text-5xl lg:text-6xl font-extrabold tracking-tight text-app leading-tight"
    >
      <span id="hero-greeting">{t("hero.greeting")} </span>
      <span
        id="hero-name"
        data-text={t("hero.name")}
        class="bg-gradient-to-r from-[var(--primary)] to-[var(--primary-hover)] bg-clip-text text-primary"
      ></span>
    </h1>

    <div
      class="hero-subtitle space-y-4 text-lg text-muted leading-relaxed max-w-2xl mx-auto lg:mx-0"
    >
      <p set:html={t("hero.intro")} />

      <p>
        {t("hero.passion")}
        <br />
        <span class="block mt-2 font-bold text-strong text-xl">
          {t("hero.cta")}
        </span>
      </p>
    </div>

    <div
      id="hero-location"
      class="flex items-center justify-center lg:justify-start gap-2 text-sm text-[var(--primary)] font-medium"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path
          d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"
        ></path></svg
      >
      {t("hero.location")}
    </div>

    <div
      id="hero-socials"
      class="flex gap-4 pt-4 justify-center lg:justify-start"
    >
      {
        SOCIALS.map(({ href, icon: Icon, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="
            flex items-center justify-center p-3 rounded-xl
            border border-[var(--border-app-soft)] text-muted
            transition-all duration-300 ease-in-out
            hover:scale-110 hover:-translate-y-1
            hover:border-[var(--primary)] hover:text-[var(--primary)] hover:bg-[var(--surface-1)]
            shadow-sm
          "
          >
            <Icon class="size-6" />
          </a>
        ))
      }
    </div>
  </div>

  <div class="lg:col-span-3 flex justify-center items-center relative">
    <div
      class="absolute inset-0 bg-[var(--primary)] blur-[90px] opacity-20 rounded-full"
    >
    </div>

    <div
      id="hero-avatar-wrapper"
      class="relative w-48 h-48 md:w-64 md:h-64 lg:w-80 lg:h-80 aspect-square"
    >
      <img
        src="https://avatars.githubusercontent.com/u/109354319?s=400&u=6e30a1b9fc1d804fdb55c573fe2519d42f311cf1&v=4"
        alt={t("hero.avatar")}
        class="w-full h-full object-cover rounded-full"
        style="outline: 3px solid var(--primary); outline-offset: 5px;"
      />
    </div>
  </div>
</div>

<div
  id="scroll-indicator"
  class="fixed bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 pointer-events-none z-20 transition-opacity duration-500 hidden sm:flex"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-muted/50 animate-bounce"
  >
    <path d="M12 5v14M5 12l7 7 7-7"></path>
  </svg>
</div>

<script>
  import { gsap } from "gsap";

  const nameEl = document.getElementById("hero-name")!;
  const nameText = nameEl.dataset.text ?? "";

  function splitChars(el: HTMLElement, text: string): HTMLSpanElement[] {
    const chars: HTMLSpanElement[] = [];
    for (const char of text) {
      const span = document.createElement("span");
      span.textContent = char;
      span.style.display = char === " " ? "inline" : "inline-block";
      span.style.willChange = "transform";
      el.appendChild(span);
      chars.push(span);
    }
    return chars;
  }

  const nameChars = splitChars(nameEl, nameText);

  const badge = document.getElementById("hero-badge")!;
  const location = document.getElementById("hero-location")!;
  const socials = document.getElementById("hero-socials")!;
  const avatarWrapper = document.getElementById("hero-avatar-wrapper")!;
  const scrollIndicator = document.getElementById("scroll-indicator")!;

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
  tl.from(badge, { duration: 0.5, y: 16, opacity: 0 })
    .from(".hero-title", { duration: 0.6, y: 60, opacity: 0 }, "-=0.2")
    .from(".hero-subtitle", { duration: 0.7, y: 30, opacity: 0 }, "-=0.45")
    .from(location, { duration: 0.5, y: 16, opacity: 0 }, "-=0.4")
    .from(socials, { duration: 0.5, y: 16, opacity: 0 }, "-=0.3")
    .from(
      avatarWrapper,
      { duration: 0.9, y: -24, opacity: 0, scale: 0.95 },
      0.15,
    )
    .from(scrollIndicator, { duration: 0.6, opacity: 0 }, "-=0.2");

  // Float loop — starts after entrance completes
  gsap.to(avatarWrapper, {
    y: -10,
    duration: 3,
    ease: "sine.inOut",
    repeat: -1,
    yoyo: true,
    delay: 1.6,
  });

  const SCALES = [1.2, 1.0, 1.0];

  nameChars.forEach((char, i) => {
    if (char.textContent === " ") return;

    char.addEventListener("mouseenter", () => {
      nameChars.forEach((other, j) => {
        const dist = Math.abs(i - j);
        const scale = SCALES[dist] ?? 1;
        gsap.to(other, {
          scale,
          duration: 0.25,
          ease: "back.out(2)",
          overwrite: "auto",
        });
      });
    });

    char.addEventListener("mouseleave", () => {
      gsap.to(nameChars, {
        scale: 1,
        duration: 0.4,
        ease: "elastic.out(1, 0.5)",
        overwrite: "auto",
      });
    });
  });

  // Hide scroll indicator when user scrolls past hero
  window.addEventListener(
    "scroll",
    () => {
      scrollIndicator.style.opacity = window.scrollY > 80 ? "0" : "1";
    },
    { passive: true },
  );
</script>
