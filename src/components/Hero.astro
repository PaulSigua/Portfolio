---
import Linkedin from "./icons/Linkedin.astro";
import Github from "./icons/Github.astro";
import Mail from "./icons/Mail.astro";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const SOCIALS = [
  {
    href: "https://www.linkedin.com/in/paulsigua/",
    icon: Linkedin,
    label: "LinkedIn",
  },
  {
    href: "https://github.com/PaulSigua",
    icon: Github,
    label: "GitHub",
  },
  {
    href: "mailto:paulmateo0208@gmail.com",
    icon: Mail,
    label: "Email",
  },
];
---

<section
  id="hero-content"
  class="grid lg:grid-cols-12 gap-12 lg:gap-14 items-center w-full py-8 sm:py-12 lg:py-16"
>
  <!-- Columna Izquierda: Información, Tipografía y Acciones -->
  <div class="lg:col-span-6 space-y-7 text-left">
    <!-- Eyebrow Tag -->
    <div id="hero-eyebrow" class="flex items-center gap-2.5">
      <span class="text-xs sm:text-sm font-bold tracking-wider text-muted uppercase">
        {t("hero.eyebrow")}
      </span>
    </div>

    <!-- Título Principal de Alto Impacto -->
    <h1
      id="hero-title"
      class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-app leading-[1.08]"
    >
      <span>{t("hero.title.main")}</span>
      <span
        class="block mt-1"
      >
        {t("hero.title.highlight")}
      </span>
    </h1>

    <!-- Descripción del Desarrollador -->
    <p
      id="hero-desc"
      class="text-base sm:text-lg text-muted leading-relaxed max-w-xl"
    >
      {t("hero.description")}
    </p>

    <!-- Botones de Acción (CTA) -->
    <div id="hero-actions" class="flex flex-wrap items-center gap-4 pt-1">
      <button
        onclick="window.toggleDialog('modal-service-contact')"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-[var(--primary-fg)] font-bold text-sm shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer"
      >
        <span>{t("hero.cta.contact")}</span>
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>

      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 text-app font-semibold text-sm border border-app-soft transition-all duration-200 hover:scale-105"
      >
        <span>{t("hero.cta.projects")}</span>
      </a>
    </div>

    <!-- Micro Tarjeta Inferior de Disponibilidad y Redes -->
    <div
      id="hero-footer"
      class="pt-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-app-soft/40 max-w-xl"
    >
      <div class="flex items-center gap-3">
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-app leading-tight">
            {t("hero.badge.card")}
          </span>
          <button
            onclick="window.toggleDialog('modal-service-contact')"
            class="text-xs font-bold text-[var(--primary)] hover:underline mt-0.5 text-left inline-flex items-center gap-1 cursor-pointer"
          >
            <span>{t("hero.badge.action")}</span>
            <span>→</span>
          </button>
        </div>
      </div>

      <!-- Redes Sociales -->
      <div class="flex items-center gap-2">
        {
          SOCIALS.map(({ href, icon: Icon, label }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="p-2.5 rounded-xl border border-app-soft text-muted hover:text-app hover:border-[var(--primary)] hover:bg-black/5 dark:hover:bg-white/10 transition-all hover:scale-110"
            >
              <Icon class="size-4" />
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Stack de Tarjetas de Servicios Flotantes (Liquid Glass) -->
  <div
    id="hero-cards-stack"
    class="lg:col-span-6 relative flex justify-center items-center py-8 lg:py-4 select-none"
  >
    <!-- Resplandor Ambiental de Fondo (Aurora Glow) -->
    <div
      class="absolute -inset-4 sm:-inset-8 bg-gradient-to-tr from-pink-500/15 via-purple-500/15 to-cyan-400/20 blur-3xl opacity-60 dark:opacity-35 rounded-full pointer-events-none -z-10 animate-pulse"
      style="animation-duration: 8s;"
    >
    </div>

    <!-- Contenedor Maestro de Tarjetas -->
    <div class="relative w-full max-w-[420px] mx-auto">
      <!-- ── 1. Tarjeta Flotante Superior (Frontend Apps) ────────────────── -->
      <div
        class="absolute -top-7 right-2 sm:right-4 z-20 liquid-glass rounded-2xl p-3 shadow-xl flex items-center gap-3 border border-white/30 dark:border-white/10 backdrop-blur-xl animate-float-slow hover:scale-105 transition-transform duration-300"
      >
        <div
          class="size-8 rounded-xl bg-gradient-to-tr from-blue-500 to-cyan-400 flex items-center justify-center text-white shrink-0 shadow-sm"
        >
          <svg
            class="size-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <div class="flex flex-col pr-1">
          <span class="text-[11px] font-bold text-app leading-tight">
            {t("hero.card.service1.title")}
          </span>
          <span class="text-[10px] text-muted font-medium">
            {t("hero.card.service1.sub")}
          </span>
        </div>
        <span
          class="size-2 rounded-full bg-[var(--primary)] ml-1 shadow-xs"
        ></span>
      </div>

      <!-- ── 2. Tarjeta Flotante Izquierda (APIs & Microservicios) ───────── -->
      <div
        class="absolute top-1/4 -left-4 sm:-left-8 z-20 liquid-glass rounded-2xl p-3 shadow-xl flex flex-col items-center gap-2 border border-white/30 dark:border-white/10 backdrop-blur-xl animate-float-delay hover:scale-105 transition-transform duration-300"
      >
        <div
          class="size-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-400 flex items-center justify-center text-white shadow-sm"
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
          </svg>
        </div>
        <div class="text-center">
          <span class="block text-[11px] font-bold text-app">FastAPI</span>
          <span class="block text-[9px] text-muted font-medium">99.9% Speed</span>
        </div>
        <span
          class="text-[9px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full"
        >
          Active
        </span>
      </div>

      <!-- ── 3. Tarjeta Principal Central (Fintech-Glass Showcase) ────────── -->
      <div
        class="relative z-10 w-full rounded-3xl liquid-glass p-6 sm:p-7 shadow-2xl border border-white/40 dark:border-white/10 backdrop-blur-2xl flex flex-col gap-5 hover:shadow-3xl transition-shadow duration-300"
      >
        <!-- Header de la Tarjeta Principal -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="relative size-10 rounded-full overflow-hidden ring-2 ring-[var(--primary)]/40">
              <img
                src="https://avatars.githubusercontent.com/u/109354319?s=400&u=6e30a1b9fc1d804fdb55c573fe2519d42f311cf1&v=4"
                alt={t("hero.avatar")}
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <span class="block text-xs font-bold text-app">Paúl Sigua</span>
              <span class="block text-[10px] text-muted font-medium">
                {t("hero.card.main.badge")}
              </span>
            </div>
          </div>
          <span
            class="text-xs font-semibold px-2.5 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] border border-[var(--primary)]/20"
          >
            PRO
          </span>
        </div>

        <!-- Bloque Principal de Valor / Métricas -->
        <div class="p-4 rounded-2xl bg-black/5 dark:bg-white/5 border border-white/10 flex flex-col gap-1">
          <span class="text-[11px] font-bold text-muted uppercase tracking-wider">
            {t("hero.card.main.title")}
          </span>
          <span class="text-2xl sm:text-3xl font-black text-app tracking-tight">
            Fullstack Dev
          </span>
          <div class="flex items-center justify-between pt-2 text-[10px] text-muted font-mono">
            <span>•••• •••• •••• 2026</span>
            <span class="text-emerald-500 font-bold">100% Delivery</span>
          </div>
        </div>

        <!-- Mini-Fichas de Servicios Interiores -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Ficha Backend -->
          <div
            class="p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-white/10 flex flex-col gap-1 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold text-app">
                {t("hero.card.service2.title")}
              </span>
              <svg class="size-3.5 text-[var(--primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
            <span class="text-[9px] text-muted font-medium">FastAPI · Python</span>
          </div>

          <!-- Ficha Cloud & DB -->
          <div
            class="p-3 rounded-xl bg-black/5 dark:bg-white/5 border border-white/10 flex flex-col gap-1 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
          >
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold text-app">
                {t("hero.card.service3.title")}
              </span>
              <svg class="size-3.5 text-[var(--primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
            <span class="text-[9px] text-muted font-medium">PostgreSQL · SQL</span>
          </div>
        </div>

        <!-- Barra de Acción Inferior -->
        <div class="flex items-center justify-between pt-1 border-t border-white/10">
          <div class="flex items-center gap-1.5 text-muted">
            <span class="size-2 rounded-full bg-[var(--primary)]"></span>
            <span class="text-[11px] font-medium">Cuenca, EC 🇪🇨</span>
          </div>
          <button
            onclick="window.toggleDialog('modal-service-contact')"
            class="px-4 py-2 rounded-full bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-[var(--primary-fg)] font-bold text-xs shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer"
          >
            {t("hero.cta.contact")}
          </button>
        </div>
      </div>

      <!-- ── 4. Tarjeta Flotante Inferior Derecha (Cloud & DB) ─────────────── -->
      <div
        class="absolute -bottom-6 -right-2 sm:-right-6 z-20 liquid-glass rounded-2xl p-3 shadow-xl flex items-center gap-3 border border-white/30 dark:border-white/10 backdrop-blur-xl animate-float-reverse hover:scale-105 transition-transform duration-300"
      >
        <div
          class="size-8 rounded-xl bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white shrink-0 shadow-sm"
        >
          <svg
            class="size-4.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <div class="flex flex-col pr-1">
          <span class="text-[11px] font-bold text-app leading-tight">
            {t("hero.card.service4.title")}
          </span>
          <span class="text-[10px] text-muted font-medium">
            Docker · CI/CD
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes floatSlow {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes floatDelay {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @keyframes floatReverse {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .animate-float-slow {
    animation: floatSlow 6s ease-in-out infinite;
  }

  .animate-float-delay {
    animation: floatDelay 7s ease-in-out infinite 1s;
  }

  .animate-float-reverse {
    animation: floatReverse 5s ease-in-out infinite 0.5s;
  }
</style>

<script>
  import { gsap } from "gsap";

  const eyebrow = document.getElementById("hero-eyebrow");
  const title = document.getElementById("hero-title");
  const desc = document.getElementById("hero-desc");
  const actions = document.getElementById("hero-actions");
  const footer = document.getElementById("hero-footer");
  const cardsStack = document.getElementById("hero-cards-stack");

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

  if (eyebrow && title && desc && actions && footer && cardsStack) {
    tl.from(eyebrow, { duration: 0.5, y: 20, opacity: 0 })
      .from(title, { duration: 0.7, y: 40, opacity: 0 }, "-=0.3")
      .from(desc, { duration: 0.6, y: 25, opacity: 0 }, "-=0.4")
      .from(actions, { duration: 0.5, y: 20, opacity: 0 }, "-=0.3")
      .from(footer, { duration: 0.5, y: 20, opacity: 0 }, "-=0.3")
      .from(cardsStack, { duration: 0.9, scale: 0.92, opacity: 0, ease: "back.out(1.5)" }, "-=0.7");
  }
</script>

