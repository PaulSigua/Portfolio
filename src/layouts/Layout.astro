---
import Background from "../components/Background.astro";
import Modal from "../components/Modal.astro";
import "@fontsource-variable/onest";
import "../styles/global.css";
import { useTranslations } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  lang?: "en" | "es";
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = "Paúl Sigua | Portfolio",
  description,
  lang = "en",
  canonicalURL = Astro.url.href,
  ogImage = "https://avatars.githubusercontent.com/u/109354319?s=400&u=6e30a1b9fc1d804fdb55c573fe2519d42f311cf1&v=4",
} = Astro.props;

const t = useTranslations(lang);

const defaultDescription =
  lang === "es"
    ? "Desarrollador fullstack especializado en Angular, React y FastAPI. Disponible para proyectos freelance y colaboraciones."
    : "Fullstack developer specialized in Angular, React, and FastAPI. Available for freelance projects and collaborations.";

const metaDescription = description || defaultDescription;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XKP7EHQW36"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XKP7EHQW36");
    </script>
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-PV575ZHR");
    </script>

    <!-- Primary Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Hreflang for language alternates -->
    <link rel="alternate" hreflang="en" href={Astro.site ?? "/"} />
    <link rel="alternate" hreflang="es" href={`${Astro.site ?? ""}es/`} />
    <link rel="alternate" hreflang="x-default" href={Astro.site ?? "/"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:site_name" content="Paúl Sigua | Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Robots & indexing -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Paúl Sigua" />
    <meta
      name="keywords"
      content="Paúl Sigua, portfolio, fullstack developer, Angular, React, FastAPI, freelance, Ecuador"
    />

    <script src="/scripts/theme.js" defer></script>
  </head>
  <body class="font-sans antialiased min-h-screen">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PV575ZHR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <Background />
    <slot />

    <Modal id="color-selector" title={t("header.color-selector")}>
      <div class="flex items-center justify-center gap-4 flex-wrap p-2">
        <button
          class="size-11 rounded-full cursor-pointer hover:scale-110 transition-transform shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-app focus:ring-zinc-400 border border-app-soft relative overflow-hidden"
          style="background: linear-gradient(135deg, #09090b 50%, #ffffff 50%);"
          onclick="window.setAppColor('mono'); window.toggleDialog('color-selector')"
          aria-label="Monocromo (Blanco y Negro)"
          title="Monocromo (Blanco y Negro)"
        ></button>
        <button
          class="size-11 rounded-full cursor-pointer hover:scale-110 transition-transform shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-app focus:ring-blue-500"
          style="background-color: #3b82f6"
          onclick="window.setAppColor('blue'); window.toggleDialog('color-selector')"
          aria-label="Azul"
          title="Azul"
        ></button>
        <button
          class="size-11 rounded-full cursor-pointer hover:scale-110 transition-transform shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-app focus:ring-emerald-500"
          style="background-color: #22c55e"
          onclick="window.setAppColor('green'); window.toggleDialog('color-selector')"
          aria-label="Verde"
          title="Verde"
        ></button>
        <button
          class="size-11 rounded-full cursor-pointer hover:scale-110 transition-transform shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-app focus:ring-orange-500"
          style="background-color: #f97316"
          onclick="window.setAppColor('orange'); window.toggleDialog('color-selector')"
          aria-label="Naranja"
          title="Naranja"
        ></button>
        <button
          class="size-11 rounded-full cursor-pointer hover:scale-110 transition-transform shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-app focus:ring-purple-500"
          style="background-color: #8b5cf6"
          onclick="window.setAppColor('purple'); window.toggleDialog('color-selector')"
          aria-label="Morado"
          title="Morado"
        ></button>
      </div>
    </Modal>

    <Modal id="modal-experience" title="">
      <div class="flex flex-col gap-4">
        <div
          id="modal-header-logo"
          class="w-16 h-16 p-2 bg-white rounded-lg border border-app-soft hidden"
        >
          <img
            id="modal-img"
            src=""
            alt=""
            class="w-full h-full object-contain"
          />
        </div>
        <div id="modal-full-description" class="text-muted leading-relaxed">
        </div>
        <div id="modal-tags" class="flex flex-wrap gap-2"></div>
      </div>
    </Modal>
  </body>
</html>

<style>
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
